{
	"$schema": "https://opencode.ai/config.json",
	"theme": "github",
	"autoupdate": false,
	"default_agent": "plan",
	"subagent_depth": 2,
	"watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  },
	"plugin": [
		"opencode-ralph-loop"
	],
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"read": "allow",
		"grep": "allow",
		"glob": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"webfetch": "allow",
		"question": "allow"
	},
	"provider": {
		"vllm": {
			"options": {
				"name": "vllm",
				"baseURL": "{file:./vllm-url}"
			},
			"models": {
				"gemma4": {
					"name": "gemma4-12B",
					"limit": {
						"context": 543,
						"output": 2000
					}
				}
			}
		}
	},
	"mcp": {
		"kubernetes": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"kubernetes-mcp-server@latest",
				"--read-only"
			],
			"enabled": false
		},
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
			"oauth": false,
			"headers": {
				"Authorization": "{file:./gh-token}"
			},
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
			"enabled": true
		}
	}
}
