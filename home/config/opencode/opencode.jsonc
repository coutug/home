{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
  "shell": "/bin/zsh",
	"default_agent": "plan",
	"experimental": {
		"subagent_depth": 2
	},
	"watcher": {
		"ignore": ["node_modules/**", "dist/**", ".git/**"]
	},
	"plugins": [
    // https://github.com/william-ricchiuti/OpenCode-goal-plugin/tree/v0.11.1
		"opencode-goal-plugin@0.11.1",
		"@mohak34/opencode-notifier@1.0.0"
	],
	"providers": {
		"openai": {
			"models": {
				"gpt-6.1-sol": {
					"variants": [
						{ "id": "medium", "settings": { "reasoningEffort": "medium", "textVerbosity": "low" } },
						{ "id": "high", "settings": { "reasoningEffort": "high", "textVerbosity": "low" } }
					]
				},
				"gpt-6-luna": {
					"variants": [
						{ "id": "high", "settings": { "reasoningEffort": "high", "textVerbosity": "low" } }
					]
				}
			}
		},
		"vllm": {
			"name": "vllm",
			"settings": {
				"baseURL": "{file:./vllm-url}"
			},
			"models": {
				"gemma4": {
					"name": "gemma4-12B",
					"capabilities": {
						"tools": true
					},
					"limit": {
						"context": 543,
						"output": 2000
					}
				}
			}
		}
	},
	"mcp": {
		"servers": {
			"kubernetes": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"kubernetes-mcp-server@latest",
					"--read-only"
				],
				"disabled": true
			},
			"github": {
				"type": "remote",
				"url": "https://api.githubcopilot.com/mcp/",
				"oauth": false,
				"headers": {
					"Authorization": "{file:./gh-token}"
				},
			},
			"gh_grep": {
				"type": "remote",
				"url": "https://mcp.grep.app"
			}
		}
	}
}
