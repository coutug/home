{
	"$schema": "https://opencode.ai/config.json",
	"update": "disable",
  "model": "openrouter/auto-low",
  "shell": "/bin/zsh",
	"default_agent": "plan",
	"permissions": [
		{ "action": "shell", "resource": "agent-browser *", "effect": "ask" },
		{ "action": "chrome-devtools_*", "resource": "*", "effect": "ask" },
		{ "action": "penpot_*", "resource": "*", "effect": "ask" },
		{ "action": "libreoffice_*", "resource": "*", "effect": "ask" },
		{ "action": "libreoffice_calc_find_text", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_get_cell_info", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_get_range", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_get_sheet_layout", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_charts", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_comments", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_conditional_formats", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_images", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_named_ranges", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_calc_list_sheets", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_find_text", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_get_notes", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_get_overview", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_get_shape", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_get_slide", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_get_text", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_impress_list_masters", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_office_get_document_info", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_office_list_documents", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_office_status", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_find_text", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_bookmarks", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_comments", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_footnotes", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_headers_footers", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_hyperlinks", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_images", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_outline", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_page_setup", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_paragraph", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_structure", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_table", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_tables", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_text", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_get_track_changes", "resource": "*", "effect": "allow" },
		{ "action": "libreoffice_writer_list_styles", "resource": "*", "effect": "allow" }
	],
	"experimental": {
		"subagent_depth": 2
	},
	"watcher": {
		"ignore": ["node_modules/**", "dist/**", ".git/**"]
	},
	"plugins": [
    // https://github.com/william-ricchiuti/OpenCode-goal-plugin/tree/v0.11.1
    "opencode-goal-plugin@0.11.1",
    "github:coutug/oc-show-model#v0.2.0",
		"@mohak34/opencode-notifier@1.0.0"
    // "@upstash/context7-opencode", to rework
	],
	"providers": {
		"openrouter": {
			"headers": {
				"X-OpenRouter-Metadata": "enabled"
			},
			"models": {
				"auto-high": {
					"modelID": "openrouter/auto",
					"name": "Auto Router — High cost",
					"body": {
						"plugins": [
							{ "id": "auto-router", "cost_tier": "high" }
						]
					}
				},
				"auto-medium": {
					"modelID": "openrouter/auto",
					"name": "Auto Router — Medium cost",
					"body": {
						"plugins": [
							{ "id": "auto-router", "cost_tier": "medium" }
						]
					}
				},
				"auto-low": {
					"modelID": "openrouter/auto",
					"name": "Auto Router — Low cost",
					"body": {
						"plugins": [
							{ "id": "auto-router", "cost_tier": "low" }
						]
					}
				}
			}
		},
		"vllm": {
			"name": "vLLM",
			"settings": {
				"baseURL": "{file:./vllm-url}"
			},
			"models": {
				"qwen38": {
					"name": "Qwen3.8-27B INT4 — local",
					"capabilities": {
						"tools": true,
						"input": ["text"],
						"output": ["text"]
					},
					"limit": {
						"context": 32768,
						"output": 4096
					},
					"body": {
						"temperature": 0.7,
						"top_p": 0.8,
						"top_k": 20,
						"presence_penalty": 1.5,
						"chat_template_kwargs": {
							"enable_thinking": false
						}
					},
					"variants": [
						{
							"id": "think",
							"body": {
								"temperature": 1.0,
								"top_p": 0.95,
								"top_k": 20,
								"presence_penalty": 0.0,
								"chat_template_kwargs": {
									"enable_thinking": true
								}
							}
						}
					]
				}
			}
		}
	},
	"mcp": {
		"servers": {
			"libreoffice": {
				"type": "local",
				"command": [
					"docker", "run", "-i", "--rm",
					"--mount=type=bind,source=/home/gabriel/Documents/repo/libre-office-mcp/workspace,target=/data",
					"libreoffice-mcp:local"
				],
				"disabled": true
			},
			"chrome-devtools": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"chrome-devtools-mcp@1.12.0",
					"--no-usage-statistics",
					"--performanceCrux=false",
					"--categoryMemory=false",
					"--categoryInput=false",
					"--javascriptEvaluation=false",
					"--redactNetworkHeaders=true",
					"--filesystemRoot=/tmp/opencode"
				],
				"environment": {
					"CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
				},
				"timeout": {
					"startup": 120000
				}
			},
			"kubernetes": {
				"type": "local",
				"command": [
					"npx",
					"-y",
					"kubernetes-mcp-server@latest",
					"--read-only"
				],
				"disabled": true
			},
			"github": {
				"type": "remote",
				"url": "https://api.githubcopilot.com/mcp/",
				"oauth": false,
				"headers": {
					"Authorization": "{file:./gh-token}"
				},
			},
			"gh_grep": {
				"type": "remote",
				"url": "https://mcp.grep.app"
			},
			"penpot": {
				"type": "remote",
				"url": "{file:./penpot-url}",
				"oauth": false,
				"disabled": false
			}
		}
	}
}
