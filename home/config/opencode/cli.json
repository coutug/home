{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "github",
    "mode": "system"
  },
  "scroll": {
    "speed": 1,
    "acceleration": false
  },
  "diffs": {
    "view": "auto"
  },
  "cursor": {
    "style": "block",
    "blinking": true
  },
  "mouse": true,
  "plugins": ["*", "-opencode.notifications"]
}
