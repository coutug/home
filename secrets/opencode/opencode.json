{
	"$schema": "https://opencode.ai/config.json",
	"theme": "github",
	"autoupdate": false,
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"read": "allow",
		"grep": "allow",
		"glob": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"webfetch": "allow",
		"question": "allow"
	},
	"default_agent": "plan",
	"agent": {
		"plan": {
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/plan.md}"
		},
		"build": {
			"model": "openai/gpt-5.6-terra",
			"variants": {
				"thinking": {
					"reasoningEffort": "low",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/build.md}"
		},
		"dashboard-builder": {
			"description": "Orchestrates Grafana dashboard creation and iterative test publishing",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/dashboard-builder.md}",
			"steps": 20,
			"permission": {
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"question": "allow",
				"webfetch": "allow",
				"todowrite": "allow",
				"edit": "ask",
				"bash": "ask",
				"task": "deny",
				"skill": {
					"*": "deny",
					"build-dashboard": "allow"
				}
			}
		},
		"teacher": {
			"description": "Teaches hard concepts and code",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/teacher.md}",
			"permission": {
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"question": "allow",
				"webfetch": "allow",
				"todowrite": "deny",
				"edit": "deny",
				"bash": "deny",
				"task": "deny"
			}
		}
	},
	"mcp": {
		"kubernetes": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"kubernetes-mcp-server@latest",
				"--read-only"
			],
			"enabled": false
		},
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "ENC[AES256_GCM,data:X1nZs7LFY+/y2ANU50MkZGKIMtYl40r8jRMG5kB7dH1VoMAHMEjaY+yEEvTtwyo/Ma2KLY4LtU5zcVw976pexvsi+/Qc3AwXIi60zya2BugW5oLbryx2N1fuY5JN9wiaWukjAg==,iv:QtRqQYAWgM1Gp/mXUaz0XjPzT0FXCgnaH9X2OqA7eIk=,tag:yhwRGPcygeAS1usOpEXrMQ==,type:str]"
			},
			"enabled": true
		},
		"gh_grep": {
