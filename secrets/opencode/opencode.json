{
	"$schema": "https://opencode.ai/config.json",
	"theme": "github",
	"autoupdate": false,
	"permission": {
		"edit": "allow",
		"bash": "allow",
		"read": "allow",
		"grep": "allow",
		"glob": "allow",
		"todowrite": "allow",
		"todoread": "allow",
		"webfetch": "allow",
		"question": "allow"
	},
	"default_agent": "plan",
	"agent": {
		"plan": {
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "high",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/plan.md}"
		},
		"build": {
			"model": "openai/gpt-5.6-terra",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/build.md}"
		},
		"dashboard-builder": {
			"description": "Orchestrates Grafana dashboard creation and iterative test publishing",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/dashboard-builder.md}",
			"steps": 20,
			"permission": {
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"question": "allow",
				"webfetch": "allow",
				"todowrite": "allow",
				"edit": "ask",
				"bash": "ask",
				"task": "deny",
				"skill": {
					"*": "deny",
					"build-dashboard": "allow"
				}
			}
		},
		"teacher": {
			"description": "Teaches hard concepts and code",
			"mode": "primary",
			"model": "openai/gpt-5.6-sol",
			"variants": {
				"thinking": {
					"reasoningEffort": "medium",
					"textVerbosity": "low"
				}
			},
			"prompt": "{file:./prompts/teacher.md}",
			"permission": {
				"read": "allow",
				"glob": "allow",
				"grep": "allow",
				"question": "allow",
				"webfetch": "allow",
				"todowrite": "deny",
				"edit": "deny",
				"bash": "deny",
				"task": "deny"
			}
		}
	},
	"mcp": {
		"kubernetes": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"kubernetes-mcp-server@latest",
				"--read-only"
			],
			"enabled": false
		},
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "ENC[AES256_GCM,data:hp9CEEarQyw89zFJI4AG/tXz6eC2lsUsj6VaE7zo3FuV8SMZ4kWnouUjSW+GRWgytMGL8l6DCHhhbTsE8wWEft6OzmNG50xxBFvmmmg28SM5nnKo9+lCOKNxDN70z83vLrfY3A==,iv:BqHz6sAJyc70/EHZcK1Uv/gou2FK1dbJOVOpjQM1Dnw=,tag:4jWu6/qtVmh/MXk7Fv96FQ==,type:str]"
			},
			"enabled": true
		},
		"gh_grep": {
			"type": "remote",
			"url": "https://mcp.grep.app",
